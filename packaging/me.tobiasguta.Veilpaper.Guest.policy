<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <action id="me.tobiasguta.Veilpaper.Guest">
    <description>Install a login wallpaper in a disposable Fedora test VM</description>
    <message>Administrator authorization is required to install the login wallpaper in this disposable Fedora VM only.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/veilpaper-guest/scripts/gdm_guest_installer.py</annotate>
  </action>
</policyconfig>
